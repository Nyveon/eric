---
import Contact from "@/components/landing/Contact.astro";
---

<div id="hero" class="grid w-screen h-full place-items-center">
    <div
        id="nameplate"
        class="flex flex-col justify-center items-center text-center size-54 rounded-sm text-white backdrop-contrast-95 backdrop-blur-xs"
    >
        <h1
            id="nametag"
            data-detail="Eric K."
            class="text-5xl font-thin cursor-default h-100 flex flex-col justify-end"
        >
            Eric K.
        </h1>

        <Contact />
    </div>
</div>

<script>
    const nameplate = document.getElementById("nameplate")!;
    const nametag = document.getElementById("nametag")!;
    let interval: ReturnType<typeof setInterval>;
    const letters = "abcdefghijklmnopqrstuvwxyz".split("");

    nameplate.addEventListener("flipName", (e: CustomEventInit<string>) => {
        let targetText = e.detail;

        if (!targetText) {
            targetText = nametag.dataset.detail!;
        }

        if (targetText === nametag.innerText) {
            return;
        }

        if (targetText.length > nametag.innerText.length) {
            const difference =
                (targetText.length - nametag.innerText.length) / 2;
            const goal = nametag.innerText.length + difference;
            nametag.innerText = nametag.innerText.padStart(goal, ".");
            nametag.innerText = nametag.innerText.padEnd(
                targetText.length,
                ".",
            );
        }

        let iteration = 0;
        clearInterval(interval);

        interval = setInterval(() => {
            nametag.innerText = nametag.innerText
                .split("")
                .map((_, index) => {
                    if (!targetText[index]) {
                        return "";
                    }

                    if (index < iteration) {
                        return targetText[index];
                    }

                    const returnLetter =
                        letters[Math.floor(Math.random() * letters.length)]!;

                    if (
                        targetText[index] &&
                        targetText[index] in letters &&
                        targetText[index] == targetText[index].toUpperCase()
                    ) {
                        return returnLetter.toUpperCase();
                    }
                    return returnLetter;
                })
                .join("");

            if (iteration >= targetText.length) {
                clearInterval(interval);
                iteration = 0;
            } else {
                iteration += 0.5;
            }
        }, 15);
    });
</script>
